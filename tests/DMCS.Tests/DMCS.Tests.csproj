<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DMCS.Core/DMCS.Core.csproj" />
    <!-- Built first so the metadata tests can inspect the shipped mod DLL; not referenced at runtime. -->
    <ProjectReference Include="../../src/DMCS/DMCS.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BasManagedDir</_Parameter1>
      <_Parameter2>$(BasManagedDir)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ModDllPath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../src/DMCS/bin/$(Configuration)/net472/DMCS.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
